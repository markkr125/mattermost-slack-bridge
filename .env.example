SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
MM_TOKEN=your_mattermost_personal_access_token
MM_URL=https://your.mattermost.com (without trailing slash)

# Single channel pair configuration (legacy - for backward compatibility)
SLACK_CHANNEL_ID=C0123456789
MM_CHANNEL_ID=abcde12345

# Multiple channel pairs configuration (JSON format)
# If CHANNEL_MAPPINGS is set, it takes precedence over single channel config
# Format: [{"slack": "SLACK_CHANNEL_ID", "mattermost": "MM_CHANNEL_ID"}, ...]
# Example: CHANNEL_MAPPINGS=[{"slack":"C01ABC123","mattermost":"ch1def456"},{"slack":"C02GHI789","mattermost":"ch2jkl012"}]
CHANNEL_MAPPINGS=

PORT=3000

# Storage backend configuration
# Options: 'redis' (default, requires Redis server) or 'memory' (in-memory, no persistence)
STORAGE_BACKEND=redis
REDIS_URL=redis://localhost:6379
REDIS_EXPIRY_DAYS=180

# Logging configuration
# Levels: error, warn, info, debug
LOG_LEVEL=info

# User mapping configuration (optional)
# Map Slack user IDs to custom Mattermost display names/avatars
# Format: {"SLACK_USER_ID":{"mm_user_id":"MM_USER_ID","display_name":"Display Name","avatar_url":"https://..."}}
# Example: SLACK_USER_MAPPINGS={"U12345":{"mm_user_id":"abc123","display_name":"John Doe","avatar_url":"https://example.com/avatar.jpg"}}
SLACK_USER_MAPPINGS=

# Map Mattermost user IDs to custom Slack display names/avatars
# Format: {"MM_USER_ID":{"slack_user_id":"SLACK_USER_ID","display_name":"Display Name","avatar_url":"https://..."}}
# Example: MM_USER_MAPPINGS={"abc123":{"slack_user_id":"U12345","display_name":"John Doe","avatar_url":"https://example.com/avatar.jpg"}}
MM_USER_MAPPINGS=
