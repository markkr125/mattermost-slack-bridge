SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
MM_TOKEN=your_mattermost_personal_access_token
MM_URL=https://your.mattermost.com (without trailing slash)

# Single channel pair configuration (legacy - for backward compatibility)
SLACK_CHANNEL_ID=C0123456789
MM_CHANNEL_ID=abcde12345

# Multiple channel pairs configuration (JSON format)
# If CHANNEL_MAPPINGS is set, it takes precedence over single channel config
# Format: [{"slack": "SLACK_CHANNEL_ID", "mattermost": "MM_CHANNEL_ID"}, ...]
# Example: CHANNEL_MAPPINGS=[{"slack":"C0123456789","mattermost":"abcde12345"},{"slack":"C9876543210","mattermost":"zyxwv98765"}]
CHANNEL_MAPPINGS=

PORT=3000
REDIS_URL=redis://localhost:6379
REDIS_EXPIRY_DAYS=180
